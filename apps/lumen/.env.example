# The open 2D and 3DBAG world requires no environment variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth, PostgreSQL/PostGIS, Storage and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Prefer the new Supabase secret key; the legacy service-role name is also supported.
SUPABASE_SECRET_KEY=

# Vercel AI Gateway. On Vercel, OIDC is provisioned automatically.
# Select and verify a current provider/model ID before configuring this value.
AI_GATEWAY_MODEL=
VERCEL_OIDC_TOKEN=
# Static fallback for non-Vercel hosting only.
AI_GATEWAY_API_KEY=

# Organization billing. Price is server-selected and cannot be supplied by the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ORGANIZATION_PRICE_ID=
